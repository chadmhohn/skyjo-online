{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skyjo.groundworkrevops.com/contracts/v1/schemas/common.schema.json",
  "title": "Skyjo shared contract primitives",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "roomCode": {
      "type": "string",
      "pattern": "^[A-Z0-9]{5}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "epochMilliseconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cardValue": {
      "type": "integer",
      "minimum": -2,
      "maximum": 12
    },
    "score": {
      "type": "integer",
      "minimum": -1000000000,
      "maximum": 1000000000
    },
    "playerKind": {
      "enum": ["human", "ai"]
    },
    "turnPhase": {
      "enum": ["opening-reveal", "choose-source", "choose-replacement", "round-over", "game-over"]
    }
  }
}
