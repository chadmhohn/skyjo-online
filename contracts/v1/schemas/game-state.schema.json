{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skyjo.groundworkrevops.com/contracts/v1/schemas/game-state.schema.json",
  "title": "Skyjo authoritative game state",
  "$ref": "#/$defs/gameState",
  "$defs": {
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "value", "faceUp", "removed"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/identifier" },
        "value": { "$ref": "common.schema.json#/$defs/cardValue" },
        "faceUp": { "type": "boolean" },
        "removed": { "type": "boolean" }
      }
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name", "grid", "totalScore", "roundScore"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/identifier" },
        "kind": { "$ref": "common.schema.json#/$defs/playerKind" },
        "name": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[^\\u0000\\r\\n]+$" },
        "grid": { "type": "array", "minItems": 12, "maxItems": 12, "items": { "$ref": "#/$defs/card" } },
        "totalScore": { "$ref": "common.schema.json#/$defs/score" },
        "roundScore": { "$ref": "common.schema.json#/$defs/score" }
      }
    },
    "roundScore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["playerId", "name", "roundScore", "totalScore"],
      "properties": {
        "playerId": { "$ref": "common.schema.json#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "roundScore": { "$ref": "common.schema.json#/$defs/score" },
        "totalScore": { "$ref": "common.schema.json#/$defs/score" }
      }
    },
    "roundHistoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["round", "closerId", "scores"],
      "properties": {
        "round": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "closerId": { "$ref": "common.schema.json#/$defs/identifier" },
        "scores": { "type": "array", "minItems": 2, "maxItems": 8, "items": { "$ref": "#/$defs/roundScore" } }
      }
    },
    "gameState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["players", "drawPile", "discardPile", "currentPlayerIndex", "phase", "selectedSource", "drawnCard", "round", "log", "winnerId", "nextStarterId", "roundCloserId", "finalTurnPlayerIds", "openingRevealCounts", "roundHistory"],
      "properties": {
        "players": { "type": "array", "minItems": 2, "maxItems": 8, "items": { "$ref": "#/$defs/player" } },
        "drawPile": { "type": "array", "maxItems": 150, "items": { "$ref": "#/$defs/card" } },
        "discardPile": { "type": "array", "minItems": 1, "maxItems": 150, "items": { "$ref": "#/$defs/card" } },
        "currentPlayerIndex": { "type": "integer", "minimum": 0, "maximum": 7 },
        "phase": { "$ref": "common.schema.json#/$defs/turnPhase" },
        "selectedSource": { "enum": [null, "draw", "discard"] },
        "drawnCard": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/card" }] },
        "round": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "log": { "type": "array", "maxItems": 8, "items": { "type": "string", "maxLength": 512 } },
        "winnerId": { "oneOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/identifier" }] },
        "nextStarterId": { "oneOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/identifier" }] },
        "roundCloserId": { "oneOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/identifier" }] },
        "finalTurnPlayerIds": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/identifier" } },
        "openingRevealCounts": {
          "type": "object",
          "maxProperties": 8,
          "propertyNames": { "$ref": "common.schema.json#/$defs/identifier" },
          "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 2 }
        },
        "roundHistory": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/roundHistoryEntry" } }
      }
    }
  }
}
