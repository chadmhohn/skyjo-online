{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "outDir": "server-dist",
    "rootDir": "src",
    "declaration": false
  },
  "include": ["src/aiContracts.ts", "src/aiProjection.ts", "src/aiStrategy.ts", "src/authoritativeAi.ts", "src/game.ts", "src/gameRules.ts", "src/protocolV2.ts", "src/runtime.ts", "src/serverProtocolV2.ts", "src/serverRealtime.ts", "src/serverRoomLifecycle.ts", "src/serverValidation.ts", "src/soloAiSetup.ts", "src/types.ts"]
}
