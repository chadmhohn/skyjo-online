{
  "name": "skyjo-online",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && npm run build:server && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "smoke:accounts": "node scripts/smoke-accounts.mjs",
    "smoke:ai": "npm run build:server && node scripts/smoke-ai.mjs",
    "smoke:chat": "npm run build && node scripts/smoke-chat.mjs",
    "smoke:persistence": "node scripts/smoke-persistence.mjs",
    "smoke:release": "git diff --check && npm run lint && npm run build && npm audit --audit-level=high && npm run smoke:validation && npm run smoke:ai && npm run smoke:persistence && npm run smoke:accounts",
    "smoke:validation": "npm run build:server && node scripts/smoke-validation.mjs",
    "start": "node server.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4",
    "web-push": "^3.6.7",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "^8.1.4"
  },
  "overrides": {
    "js-yaml": "^4.1.2"
  }
}
