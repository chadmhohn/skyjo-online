{
  "name": "skyjo-online",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && npm run build:server && vite build && node scripts/create-offline-shell.mjs && node scripts/build-service-worker.mjs",
    "postbuild": "node scripts/write-release-json.mjs",
    "build:server": "node scripts/clean-server-dist.mjs && tsc -p tsconfig.server.json",
    "check:audio": "node scripts/check-audio-assets.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:types": "tsc --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "certify:automated": "node scripts/run-automated-certification.mjs",
    "certify:verify": "node scripts/verify-v020-release.mjs",
    "governance:plan": "node scripts/configure-github-governance.mjs --repo chadmhohn/skyjo-online",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "release:artifact": "node scripts/build-runtime-artifact.mjs",
    "release:artifact:verify": "node scripts/verify-runtime-artifact.mjs",
    "release:sbom": "node scripts/generate-runtime-sbom.mjs",
    "smoke:accounts": "node scripts/smoke-accounts.mjs",
    "smoke:ai": "npm run build:server && node scripts/smoke-ai.mjs",
    "smoke:backup": "node scripts/smoke-backup.mjs",
    "smoke:chat": "npm run build && node scripts/smoke-chat.mjs",
    "smoke:deployed": "node scripts/smoke-deployed.mjs",
    "smoke:invite-restart": "node scripts/smoke-invite-restart.mjs",
    "smoke:delivery": "npm run test:controller && node scripts/smoke-delivery.mjs",
    "smoke:ops": "node scripts/smoke-ops.mjs",
    "smoke:persistence": "node scripts/smoke-persistence.mjs",
    "smoke:release": "git diff --check && npm run lint && npm run check:audio && npm run build && npm audit --audit-level=high && npm run smoke:validation && npm run smoke:ai && npm run smoke:persistence && npm run smoke:accounts && npm run smoke:ops && npm run smoke:backup && npm run smoke:delivery",
    "smoke:validation": "npm run build:server && node scripts/smoke-validation.mjs",
    "state:backup": "node scripts/backup-state.mjs",
    "state:restore": "node scripts/restore-state.mjs",
    "state:verify": "node scripts/verify-state-backup.mjs",
    "start": "node server.mjs",
    "test": "npm run test:unit",
    "test:controller": "node --test deploy/tests/*.test.mjs",
    "test:compat:v011": "node scripts/smoke-v011-rollback-compatibility.mjs",
    "test:ops": "node --test deploy/tests/operations-governance.test.mjs",
    "test:unit": "npm run test:unit:release && npm run test:unit:data && npm run test:unit:delivery",
    "test:unit:domain": "vitest run --config vitest.domain.config.ts --coverage",
    "test:unit:data": "vitest run --config vitest.data.config.ts --coverage",
    "test:unit:delivery": "vitest run --config vitest.delivery.config.ts --coverage",
    "test:unit:realtime": "vitest run --config vitest.realtime.config.ts --coverage",
    "test:unit:ui": "vitest run --config vitest.ui.config.ts --coverage",
    "test:unit:release": "npm run test:unit:domain && npm run test:unit:realtime && npm run test:unit:ui",
    "test:e2e": "npm run test:e2e:chromium && npm run test:e2e:webkit",
    "test:e2e:chromium": "playwright test tests/e2e/functional --project=chromium",
    "test:e2e:certification": "playwright test tests/e2e/certification/eight-client-personas.spec.ts --project=chromium --workers=1 --retries=0",
    "test:e2e:webkit": "playwright test tests/e2e/functional --project=webkit-phone --project=webkit-tablet-portrait --project=webkit-tablet-landscape",
    "test:a11y": "playwright test tests/e2e/accessibility --project=chromium --project=webkit-phone",
    "test:artifact:integration": "node scripts/test-runtime-artifact-integration.mjs",
    "test:visual": "playwright test tests/e2e/visual --project=chromium",
    "test:lighthouse": "node scripts/run-lighthouse.mjs",
    "test:quality": "git diff --check && npm run lint && npm run check:types && npm audit --audit-level=high && npm run check:audio && npm run test:unit:delivery && npm run build && npm run check:bundle"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4",
    "web-push": "^3.6.7",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@cyclonedx/cyclonedx-npm": "6.0.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.9.0",
    "jsdom": "29.1.1",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "terser": "5.49.0",
    "typescript": "^5.5.3",
    "vite": "^8.1.4",
    "vitest": "4.1.10",
    "workbox-build": "7.4.1"
  },
  "overrides": {
    "js-yaml": "^4.1.2",
    "tmp": "0.2.7",
    "uuid": "11.1.1"
  }
}
