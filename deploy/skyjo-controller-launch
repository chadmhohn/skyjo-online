#!/bin/sh
# Installed as a root-owned LF-normalized launcher by the delivery bootstrap.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
umask 077

die() { printf '%s\n' "$*" >&2; exit 70; }

for directory in /usr /usr/local /usr/local/lib /usr/local/lib/skyjo-online /usr/local/share /usr/local/share/skyjo-online; do
  [ -d "$directory" ] && [ ! -L "$directory" ] || die 'Controller trust path is unsafe.'
  [ "$(/usr/bin/stat -c %u -- "$directory")" = 0 ] && [ "$(/usr/bin/stat -c %g -- "$directory")" = 0 ] || die 'Controller trust path ownership is unsafe.'
  mode=$(/usr/bin/stat -c %a -- "$directory")
  [ $(((0$mode) & 0022)) -eq 0 ] || die 'Controller trust path is writable.'
done

manifest=/usr/local/share/skyjo-online/delivery-assets.sha256
[ -f "$manifest" ] && [ ! -L "$manifest" ] || die 'Delivery asset manifest is unsafe.'
[ "$(/usr/bin/stat -c %u -- "$manifest")" = 0 ] && [ "$(/usr/bin/stat -c %g -- "$manifest")" = 0 ] || die 'Delivery asset manifest ownership is unsafe.'
[ "$(/usr/bin/stat -c %a -- "$manifest")" = 444 ] || die 'Delivery asset manifest mode is unsafe.'
/usr/bin/sha256sum --check --strict "$manifest" >/dev/null || die 'Delivery asset manifest verification failed.'

for file in \
  /usr/local/lib/skyjo-online/node-runtime-guard-lib.sh \
  /usr/local/lib/skyjo-online/release-controller.mjs \
  /usr/local/lib/skyjo-online/release-controller-lib.mjs \
  /usr/local/lib/skyjo-online/state-snapshot-lib.mjs \
  /usr/local/lib/skyjo-online/deployment-authorization-lib.mjs \
  /usr/local/lib/skyjo-online/validate-deployment-public-keys.mjs; do
  [ -f "$file" ] && [ ! -L "$file" ] || die 'Controller asset is unsafe.'
  [ "$(/usr/bin/stat -c %u -- "$file")" = 0 ] && [ "$(/usr/bin/stat -c %g -- "$file")" = 0 ] || die 'Controller asset ownership is unsafe.'
  [ "$(/usr/bin/stat -c %a -- "$file")" = 555 ] || die 'Controller asset mode is unsafe.'
done

. /usr/local/lib/skyjo-online/node-runtime-guard-lib.sh
skyjo_guard_node_runtime \
  /opt/skyjo-online \
  24.18.0 \
  55aa7153f9d88f28d765fcdad5ae6945b5c0f98a36881703817e4c450fa76742 \
  0 0 / || die 'Pinned Node runtime failed the pre-execution trust guard.'

exec /opt/skyjo-online/node-v24.18.0/bin/node /usr/local/lib/skyjo-online/release-controller.mjs "$@"
