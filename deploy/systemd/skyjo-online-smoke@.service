[Unit]
Description=Skyjo Online authenticated canary smoke %i
Documentation=https://github.com/chadmhohn/skyjo-online/blob/main/docs/immutable-deployment.md
After=network.target
ConditionFileNotEmpty=/run/skyjo-online-canary/%i.env

[Service]
Type=oneshot
User=skyjo
Group=skyjo
WorkingDirectory=/
Environment=NODE_ENV=production
EnvironmentFile=/etc/skyjo-online.env
EnvironmentFile=/run/skyjo-online-canary/%i.env
ExecStart=/opt/skyjo-online/node/bin/node /usr/local/libexec/skyjo-deploy/smoke-launcher.mjs
ExecCondition=/usr/bin/test ! -L /run/skyjo-online-canary/%i.env
TimeoutStartSec=30s
UMask=0077

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProcSubset=pid
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
RemoveIPC=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
