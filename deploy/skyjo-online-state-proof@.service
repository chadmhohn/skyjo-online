[Unit]
Description=Skyjo migrated canary state proof %i
After=network.target
ConditionFileNotEmpty=/run/skyjo-online-canary/%i.env
CollectMode=inactive

[Service]
Type=oneshot
User=skyjo-canary
Group=skyjo-canary
EnvironmentFile=/run/skyjo-online-canary/%i.env
ExecStart=/usr/local/lib/skyjo-online/skyjo-state-proof-launch %i
ExecCondition=/usr/bin/test ! -L /run/skyjo-online-canary/%i.env
TimeoutStartSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=false
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
SystemCallArchitectures=native
ReadWritePaths=/var/tmp/skyjo-deploy/%i
InaccessiblePaths=/var/lib/skyjo-online /etc/skyjo-online.env -/etc/skyjo-online
