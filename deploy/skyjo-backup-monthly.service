[Unit]
Description=Skyjo verified monthly backup and isolated restore drill
ConditionPathExists=/etc/skyjo-online-operations.enabled
After=skyjo-online.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/lib/skyjo-online/skyjo-ops-launch monthly
TimeoutStartSec=15min
UMask=0077
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=false
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
SystemCallArchitectures=native
ReadWritePaths=/var/backups/skyjo-online /var/tmp/skyjo-restore-drills
InaccessiblePaths=/etc/skyjo-online.env
