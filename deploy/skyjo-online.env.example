# Optional legacy rollback compatibility only; current releases do not read it for authorization.
SKYJO_ACCESS_PASSWORD=
SKYJO_SESSION_SECRET=replace-with-a-long-random-secret
SKYJO_INVITE_SECRET=replace-with-a-separate-long-random-secret
SKYJO_INVITE_TTL_HOURS=168
SKYJO_INVITE_CODE_TTL_MINUTES=30
# Full Apple application identifier prefix plus bundle ID. Do not substitute the Team ID unless it is also the App ID prefix.
SKYJO_APPLE_APPLICATION_IDENTIFIER=XXXXXXXXXX.com.groundworkrevops.skyjo
SKYJO_SESSION_TTL_HOURS=336
SKYJO_ACCOUNT_SESSION_TTL_HOURS=336
SKYJO_SECURE_COOKIES=true
SKYJO_ROOMS_FILE=/var/lib/skyjo-online/rooms.json
SKYJO_DB_FILE=/var/lib/skyjo-online/skyjo.sqlite
SKYJO_ADMIN_EMAIL=chad.hohn@groundworkrevops.com
SKYJO_ADMIN_INITIAL_PASSWORD=replace-with-a-temporary-admin-password
# Dedicated, non-admin account used only by localhost deployment smoke checks.
SKYJO_DEPLOY_SMOKE_ACCOUNT_EMAIL=skyjo-deploy-smoke@example.invalid
SKYJO_DEPLOY_SMOKE_ACCOUNT_PASSWORD=replace-with-a-long-random-smoke-password
SKYJO_DATABASE_RETRY_MS=5000
# Generate one coherent P-256 VAPID key pair. A partial, malformed, or mismatched pair fails startup.
SKYJO_VAPID_PUBLIC_KEY=replace-with-web-push-public-key
SKYJO_VAPID_PRIVATE_KEY=replace-with-web-push-private-key
# This must remain a real public-DNS contact URI; never substitute a special-use host or IP literal for a candidate.
SKYJO_VAPID_SUBJECT=mailto:chad.hohn@groundworkrevops.com
# Leave all four APNs values empty to disable native notifications. When enabled, install both
# key files as root:skyjo mode 0640 at /etc/skyjo-online/apns-provider.p8 and
# /etc/skyjo-online/apns-token.key; the token key is one canonical base64url-encoded 32-byte key.
SKYJO_APNS_TEAM_ID=
SKYJO_APNS_KEY_ID=
SKYJO_APNS_PRIVATE_KEY_FILE=
SKYJO_APNS_TOKEN_KEY_FILE=
HOST=127.0.0.1
PORT=4180
