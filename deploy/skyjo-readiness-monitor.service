[Unit]
Description=Skyjo local readiness contract monitor
ConditionPathExists=/etc/skyjo-online-operations.enabled
After=skyjo-online.service

[Service]
Type=oneshot
User=skyjo-monitor
Group=skyjo-monitor
ExecStart=/usr/local/lib/skyjo-online/skyjo-ops-launch readiness
TimeoutStartSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
SystemCallArchitectures=native
ReadWritePaths=/var/lib/skyjo-monitor
InaccessiblePaths=/etc/skyjo-online.env /var/lib/skyjo-online /var/backups/skyjo-online
