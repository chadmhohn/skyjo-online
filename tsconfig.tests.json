{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["node", "@testing-library/jest-dom", "vitest/globals"]
  },
  "include": [
    "playwright.config.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "vitest.*.config.ts"
  ]
}
